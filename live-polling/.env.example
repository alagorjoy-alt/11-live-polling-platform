# Path of the SQLite file (use a persistent disk in production)
DATABASE_PATH=polling.db
# Salt used when hashing IP addresses (change this in production)
HASH_SALT=change-me
# Also block a second vote from the same IP address (off by default: shared networks)
ENFORCE_IP_LIMIT=false
# Read the client IP from X-Forwarded-For (turn on behind Render/Railway/Fly proxies)
TRUST_PROXY=false
# Send the voter cookie only over HTTPS (turn on in production)
COOKIE_SECURE=false
